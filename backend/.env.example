# ==============================================================================
# ZeroTrustNet Backend Configuration
# Store all secrets and Supabase credentials in environment variables
# ==============================================================================

# Supabase API Credentials
# Replace with your Supabase Project Settings -> API credentials
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-secret-key-placeholder
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Backend JWT Signing Secret (Used for session tokens and hybrid auth)
SECRET_KEY=ZTN_SUPER_SECRET_KEY_CYBER_2026_ADAPTIVE_MFA_PROD

# Server configuration
PORT=5000
FLASK_ENV=production
DEBUG=False

# ==============================================================================
# Twilio Live SMS Multi-Factor Authentication Configuration
# Provide your Twilio Console credentials for real live SMS OTP dispatch
# ==============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
# Default fallback recipient mobile number (E.164 format, e.g. +919876543210 or +14155552671)
DEFAULT_SMS_RECIPIENT=+919876543210
